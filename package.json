{
  "name": "mathwhiz-world-academy",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build",
    "build:next": "next build",
    "start": "next start",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "deploy": "npm run build && npm run cf-deploy",
    "cf-deploy": "opennextjs-cloudflare deploy && wrangler d1 migrations apply mathwhiz-world --remote",
    "db:migrate:local": "wrangler d1 migrations apply mathwhiz-world --local",
    "db:migrate:remote": "wrangler d1 migrations apply mathwhiz-world --remote",
    "db:seed:generate": "node scripts/generate-seed.mjs",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.18",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "clsx": "2.1.1",
    "framer-motion": "12.43.0",
    "lucide-react": "0.460.0",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "^0.0.1",
    "three": "0.180.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/node": "22.15.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/three": "0.180.0",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.2",
    "wrangler": "^4.168.0"
  }
}
