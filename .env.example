# MySQL connection string
DATABASE_URL="mysql://root:password@localhost:3306/mathwhiz"

# Public site URL (no trailing slash) — used for SEO, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL="https://www.mathwhizworld.com"

# Long random string used to sign admin sessions. Generate with:  openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# First admin account created by `npm run db:seed`
ADMIN_EMAIL="admin@mathwhizworld.com"
ADMIN_PASSWORD="ChangeMe!2026"
ADMIN_NAME="MathWhiz Admin"

# Optional: Google Search Console verification token
NEXT_PUBLIC_GOOGLE_VERIFICATION=""
