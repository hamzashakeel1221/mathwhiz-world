// MathWhiz World Academy — database schema (MySQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Curriculum {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  shortTitle     String
  code           String?
  board          String
  level          String
  yearRange      String
  tagline        String   @db.VarChar(255)
  summary        String   @db.Text
  description    String   @db.Text
  topics         Json
  highlights     Json
  examStructure  Json?
  accent         String   @default("teal")
  featured       Boolean  @default(false)
  published      Boolean  @default(true)
  sortOrder      Int      @default(0)
  seoTitle       String?
  seoDescription String?  @db.VarChar(320)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([published, sortOrder])
}

model Review {
  id         String   @id @default(cuid())
  name       String
  role       String?
  country    String?
  curriculum String?
  rating     Int      @default(5)
  content    String   @db.Text
  approved   Boolean  @default(false)
  featured   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([approved, featured])
}

enum BookingStatus {
  NEW
  CONTACTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

model DemoBooking {
  id            String        @id @default(cuid())
  studentName   String
  parentName    String?
  email         String
  whatsapp      String
  country       String?
  timezone      String?
  curriculum    String
  yearLevel     String?
  preferredTime String?
  message       String?       @db.Text
  status        BookingStatus @default(NEW)
  adminNotes    String?       @db.Text
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt])
}

model Faq {
  id        String   @id @default(cuid())
  question  String   @db.VarChar(500)
  answer    String   @db.Text
  category  String   @default("General")
  sortOrder Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  icon        String   @default("Sparkles")
  sortOrder   Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
